# Datos cacheados y salidas de corridas: se regeneran, no se versionan.
cache/
output/
reports/
logs/

# Estado del broker: contiene datos de la cuenta.
state/

# Exports del broker (numero de cuenta y posiciones): dato sensible, no se versiona.
posiciones/

# Secretos locales (claves de API). NUNCA versionar.
.secrets/
.env

# Entornos y herramientas.
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Artefactos compilados de Python: se regeneran, no se versionan.
__pycache__/
*.py[cod]