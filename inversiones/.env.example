# Configuración Opcional del Analizador de Inversiones

# Llaves de API de LLM (Opcional: Si se configuran, se genera un informe cualitativo senior con IA;
# si no están configuradas, el sistema funciona de forma 100% autónoma con su motor de scoring y NLP local)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proveedor preferido de LLM: gemini | openai | anthropic | local
LLM_PROVIDER=local

# Puerto de la Interfaz Web
PORT=5000
HOST=127.0.0.1
DEBUG=False

# Tipo de cambio USD/CLP (usado para conversiones y reportes)
USDCLP=940

# Pesos del Motor de Decisión (suman 1.0)
WEIGHT_TECHNICAL=0.30
WEIGHT_FUNDAMENTAL=0.35
WEIGHT_NEWS=0.20
WEIGHT_GEOPOLITICAL=0.15
