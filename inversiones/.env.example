# Copy this file to .env and set only the providers you intend to use.
# Never commit real API keys.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_with_a_newly_generated_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PORTFOLIO_EFFORT=high
DEEPSEEK_DISCOVERY_EFFORT=low
DEEPSEEK_PORTFOLIO_MAX_TOKENS=2200
DEEPSEEK_DISCOVERY_MAX_TOKENS=3000
DEEPSEEK_MAX_CONCURRENCY=2
