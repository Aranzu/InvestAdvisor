# Copy this file to .env and set only the providers you intend to use.
# Never commit real API keys.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_a_newly_generated_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FLASH_MODEL=openai/gpt-oss-20b
GROQ_PORTFOLIO_MAX_TOKENS=2500
GROQ_DISCOVERY_MAX_TOKENS=4500
GROQ_MAX_CONCURRENCY=2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_PORTFOLIO_MAX_TOKENS=2500
OPENROUTER_DISCOVERY_MAX_TOKENS=2400